# Template for the Redis password Secret (real values are never committed).
# Option 1 - from this file:
#   cp kubernetes/visit-counter-secret.yaml.example kubernetes/visit-counter-secret.yaml
#   Replace the placeholder, then: kubectl apply -f kubernetes/visit-counter-secret.yaml
# Option 2 - without any file:
#   kubectl create secret generic visit-counter-secret -n kubernetes-learning \
#     --from-literal=REDIS_PASSWORD='your-password'
apiVersion: v1
kind: Secret
metadata:
  name: visit-counter-secret
  namespace: kubernetes-learning
type: Opaque
stringData:
  REDIS_PASSWORD: "change-me"
